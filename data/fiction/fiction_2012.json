{
    "story_id": 2012,
    "story_name": "陈腔滥调",
    "blessing": [
        {
            "id": 3031207,
            "name": "终结技攻击",
            "description": "我方施放终结技攻击敌方目标后，每击中1个敌方目标，使我方额外积累<color style='color:#f29e38;'>5</color>点「战意值」。"
        },
        {
            "id": 3031208,
            "name": "战熄潮平",
            "description": "敌方目标被任意单位消灭后，为我方全体附上1层【回音】。"
        },
        {
            "id": 3031209,
            "name": "战意汹涌",
            "description": "进入「战意汹涌」时，消耗所有【回音】，每层【回音】对随机敌方目标造成1次固定数值的伤害。「战意汹涌」期间，敌方目标受到的伤害提高<color style='color:#f29e38;'>50%</color>，且被任意单位消灭后额外为我方全体附上1层【回音】，当【回音】叠加至<color style='color:#f29e38;'>10</color>层或以上时，消耗所有【回音】，每层【回音】对随机敌方目标造成1次固定数值的伤害。"
        }
    ],
    "buffs": [
        {
            "id": 3031333,
            "name": "共相",
            "description": "「战意汹涌」期间，我方全体速度提高<color style='color:#f29e38;'>40%</color>，消耗所有【回音】攻击时恢复1个战技点。"
        },
        {
            "id": 3031332,
            "name": "辉光",
            "description": "「战意汹涌」期间，敌方目标被任意单位消灭后，有<color style='color:#f29e38;'>50%</color>概率为我方全体附上1层【回音】。"
        },
        {
            "id": 3031334,
            "name": "潜在",
            "description": "进入「战意汹涌」时，激活我方编队中第一位角色的终结技，并使其在「战意汹涌」期间施放终结技造成的伤害提高<color style='color:#f29e38;'>50%</color>。"
        }
    ],
