{
    "story_id": 2016,
    "story_name": "三幕架构",
    "blessing": [
        {
            "id": 3031217,
            "name": "触发持续伤害",
            "description": "敌方目标每次受到持续伤害后，使我方额外积累<color style='color:#f29e38;'>2</color>点「战意值」。"
        },
        {
            "id": 3031218,
            "name": "战熄潮平",
            "description": "敌方目标进入战斗时陷入<color style='color:#f29e38;'>1</color>层特殊<color style='color:#f29e38;'>风化</color>【迷音】，行动后陷入<color style='color:#f29e38;'>1</color>层【迷音】，每回合开始时受到风属性持续伤害，最多叠加<color style='color:#f29e38;'>10</color>层，持续<color style='color:#f29e38;'>3</color>回合。"
        },
        {
            "id": 3031219,
            "name": "战意汹涌",
            "description": "进入「战意汹涌」时使敌方全体陷入<color style='color:#f29e38;'>5</color>层特殊<color style='color:#f29e38;'>风化</color>【迷音】，并使其当前承受的所有持续伤害立即产生相当于原伤害<color style='color:#f29e38;'>100%</color>的伤害。「战意汹涌」期间敌方目标受到的伤害提高<color style='color:#f29e38;'>50%</color>，造成的伤害降低<color style='color:#f29e38;'>35%</color>，速度提高<color style='color:#f29e38;'>50%</color>。"
        }
    ],
    "buffs": [
        {
            "id": 3031340,
            "name": "直叙",
            "description": "「战意汹涌」期间，我方目标造成的持续伤害无视目标<color style='color:#f29e38;'>20%</color>的全属性抗性，敌方目标受到持续伤害后，使我方全体造成的持续伤害提高<color style='color:#f29e38;'>1%</color>，最多叠加<color style='color:#f29e38;'>99</color>层，持续至「战意汹涌」结束。"
        },
        {
            "id": 3031341,
            "name": "互文",
            "description": "「战意汹涌」期间，我方目标造成的战技伤害提高<color style='color:#f29e38;'>50%</color>，攻击陷入特殊<color style='color:#f29e38;'>风化</color>【迷音】的目标时，每层【迷音】额外使战技伤害提高<color style='color:#f29e38;'>10%</color>。"
        },
        {
            "id": 3031342,
            "name": "误置",
            "description": "每层【迷音】使敌方目标受到的伤害提高<color style='color:#f29e38;'>3%</color>，「战意汹涌」期间，敌方目标进入战斗时和行动后额外叠加<color style='color:#f29e38;'>1</color>层特殊<color style='color:#f29e38;'>风化</color>【迷音】。"
        }
    ],
