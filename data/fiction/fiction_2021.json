{
    "story_id": 2021,
    "story_name": "无字小说",
    "blessing": [
        {
            "id": 3031222,
            "name": "获得笑点",
            "description": "每次获得笑点时，使我方额外积累<color style='color:#f29e38;'>2</color>点「战意值」。"
        },
        {
            "id": 3031223,
            "name": "战熄潮平",
            "description": "关卡拥有特殊的欢愉技，进入阿哈时刻时对随机敌方目标造成<color style='color:#f29e38;'>15</color>次虚数属性欢愉伤害。敌方目标被任意目标消灭时，获得<color style='color:#f29e38;'>1</color>笑点。"
        },
        {
            "id": 3031224,
            "name": "战意汹涌",
            "description": "进入「战意汹涌」时，使阿哈立即获得一个固定计入<color style='color:#f29e38;'>20</color>笑点的额外回合，本回合不消耗笑点且造成的欢愉技伤害为原伤害的<color style='color:#f29e38;'>50%</color>。「战意汹涌」期间敌方目标受到的伤害提高<color style='color:#f29e38;'>50%</color>，并使阿哈时刻的速度提升<color style='color:#f29e38;'>40</color>点。"
        }
    ],
    "buffs": [
        {
            "id": 3031353,
            "name": "狂欢",
            "description": "「战意汹涌」期间，敌方目标受到的欢愉伤害提高<color style='color:#f29e38;'>30%</color>，阿哈时刻的速度额外提高<color style='color:#f29e38;'>20</color>点。"
        },
        {
            "id": 3031354,
            "name": "狂想",
            "description": "我方目标施放普攻或战技后，获得<color style='color:#f29e38;'>1</color>个笑点；「战意汹涌」期间，我方目标造成的伤害提高<color style='color:#f29e38;'>50%</color>。"
        },
        {
            "id": 3031355,
            "name": "狂斥",
            "description": "我方目标施放攻击造成击破伤害后，获得<color style='color:#f29e38;'>1</color>个笑点；「战意汹涌」期间，敌方目标受到的击破伤害提高<color style='color:#f29e38;'>30%</color>。"
        }
    ],
