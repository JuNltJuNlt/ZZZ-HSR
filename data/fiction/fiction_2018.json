{
    "story_id": 2018,
    "story_name": "五步抑扬",
    "blessing": [
        {
            "id": 3031207,
            "name": "终结技攻击",
            "description": "我方施放终结技攻击敌方目标后，每击中1个敌方目标，使我方额外积累<color style='color:#f29e38;'>5</color>点「战意值」。"
        },
        {
            "id": 3031208,
            "name": "战熄潮平",
            "description": "敌方目标被任意单位消灭后，为我方全体附上1层【回音】。"
        },
        {
            "id": 3031209,
            "name": "战意汹涌",
            "description": "进入「战意汹涌」时，消耗所有【回音】，每层【回音】对随机敌方目标造成1次固定数值的伤害。「战意汹涌」期间，敌方目标受到的伤害提高<color style='color:#f29e38;'>50%</color>，且被任意单位消灭后额外为我方全体附上1层【回音】，当【回音】叠加至<color style='color:#f29e38;'>10</color>层或以上时，消耗所有【回音】，每层【回音】对随机敌方目标造成1次固定数值的伤害。"
        }
    ],
    "buffs": [
        {
            "id": 3031347,
            "name": "追想",
            "description": "「战意汹涌」期间，我方目标施放终结技后使我方全体造成的伤害提高<color style='color:#f29e38;'>15%</color>，最多叠加<color style='color:#f29e38;'>5</color>层，持续至「战意汹涌」结束。"
        },
        {
            "id": 3031348,
            "name": "犹记",
            "description": "进入「战意汹涌」时，立即恢复<color style='color:#f29e38;'>3</color>个战技点。「战意汹涌」期间，敌方目标受到的持续伤害提高<color style='color:#f29e38;'>30%</color>。"
        },
        {
            "id": 3031349,
            "name": "颖悟",
            "description": "「战意汹涌」期间，我方全体速度提高<color style='color:#f29e38;'>20%</color>，施放战技后为我方全体附上<color style='color:#f29e38;'>1</color>层【回音】。"
        }
    ],
