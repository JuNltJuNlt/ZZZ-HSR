{
    "story_id": 2025,
    "story_name": "构事生意",
    "blessing": [
        {
            "id": 3031232,
            "name": "追加攻击",
            "description": "我方目标施放追加攻击攻击敌方目标后，每击中1个敌方目标，使我方额外积累<color style='color:#f29e38;'>8</color>点「战意值」。"
        },
        {
            "id": 3031233,
            "name": "战熄潮平",
            "description": "我方目标施放追加攻击或终结技后，对每个被攻击的敌方目标造成攻击者<color style='color:#f29e38;'>80%</color>攻击力+<color style='color:#f29e38;'>40%</color>生命上限的附加伤害。"
        },
        {
            "id": 3031234,
            "name": "战意汹涌",
            "description": "进入「战意汹涌」时，我方全体恢复<color style='color:#f29e38;'>20%</color>能量。「战意汹涌」期间敌方目标受到的伤害提高<color style='color:#f29e38;'>50%</color>，「战熄潮平」造成的附加伤害提高<color style='color:#f29e38;'>100%</color>，且该伤害被视为追加攻击伤害。"
        }
    ],
    "buffs": [
        {
            "id": 3031363,
            "name": "暴言",
            "description": "造成的追加攻击伤害的全属性抗性穿透提高<color style='color:#f29e38;'>30%</color>，「战意汹涌」期间，我方目标施放追加攻击攻击敌方目标后，额外对每个被攻击的敌方目标相邻的目标造成攻击者<color style='color:#f29e38;'>40%</color>攻击力+<color style='color:#f29e38;'>20%</color>生命上限的附加伤害，该伤害被视为追加攻击伤害。"
        },
        {
            "id": 3031364,
            "name": "高论",
            "description": "「战意汹涌」期间，我方目标施放终结技时造成的暴击伤害提高<color style='color:#f29e38;'>60%</color>，「战意汹涌」结束时，我方全体恢复<color style='color:#f29e38;'>20%</color>能量。"
        },
        {
            "id": 3031365,
            "name": "快嘴",
            "description": "我方全体速度提高<color style='color:#f29e38;'>20%</color>。「战意汹涌」期间敌方目标受到的伤害额外提高<color style='color:#f29e38;'>30%</color>。"
        }
    ],
