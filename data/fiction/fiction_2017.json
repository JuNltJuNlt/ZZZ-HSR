{
    "story_id": 2017,
    "story_name": "主观叙事",
    "blessing": [
        {
            "id": 3031202,
            "name": "战技攻击",
            "description": "我方施放战技攻击敌方目标后，每击中1个敌方目标，使我方额外积累<color style='color:#f29e38;'>5</color>点「战意值」。"
        },
        {
            "id": 3031203,
            "name": "战熄潮平",
            "description": "战斗开始时，我方施放战技攻击敌方目标后，对每个被攻击的敌方目标造成固定数值的伤害。"
        },
        {
            "id": 3031204,
            "name": "战意汹涌",
            "description": "进入「战意汹涌」时，我方全体行动提前<color style='color:#f29e38;'>100%</color>，期间敌方目标受到的伤害提高<color style='color:#f29e38;'>50%</color>，且我方施放战技攻击敌方目标后，额外对每个被攻击的敌方目标的相邻目标造成固定数值的伤害。"
        }
    ],
    "buffs": [
        {
            "id": 3031344,
            "name": "谣曲",
            "description": "「战意汹涌」期间，忆灵造成的伤害提高<color style='color:#f29e38;'>30%</color>，当忆灵消失时，使忆师行动提前<color style='color:#f29e38;'>15%</color>。"
        },
        {
            "id": 3031345,
            "name": "奏雅",
            "description": "进入「战意汹涌」时，立即恢复<color style='color:#f29e38;'>3</color>个战技点。「战意汹涌」期间，敌方目标受到的持续伤害提高<color style='color:#f29e38;'>30%</color>。"
        },
        {
            "id": 3031346,
            "name": "孤韵",
            "description": "「战意汹涌」期间，我方施放战技攻击敌方目标后，对每个被攻击的敌方目标额外造成等同于原伤害<color style='color:#f29e38;'>30%</color>的真实伤害。"
        }
    ],
