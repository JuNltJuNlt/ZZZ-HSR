{
    "story_id": 2014,
    "story_name": "结构规律",
    "blessing": [
        {
            "id": 3031202,
            "name": "战技攻击",
            "description": "我方施放战技攻击敌方目标后，每击中1个敌方目标，使我方额外积累<color style='color:#f29e38;'>5</color>点「战意值」。"
        },
        {
            "id": 3031203,
            "name": "战熄潮平",
            "description": "战斗开始时，我方施放战技攻击敌方目标后，对每个被攻击的敌方目标造成固定数值的伤害。"
        },
        {
            "id": 3031204,
            "name": "战意汹涌",
            "description": "进入「战意汹涌」时，我方全体行动提前<color style='color:#f29e38;'>100%</color>，期间敌方目标受到的伤害提高<color style='color:#f29e38;'>50%</color>，且我方施放战技攻击敌方目标后，额外对每个被攻击的敌方目标的相邻目标造成固定数值的伤害。"
        }
    ],
    "buffs": [
        {
            "id": 3031327,
            "name": "肤廓",
            "description": "「战意汹涌」期间，我方全体战技不消耗战技点。角色施放战技或终结技后，每击中1个敌方目标获得1层【热潮】，每层使该角色造成的战技和终结技伤害提高<color style='color:#f29e38;'>4%</color>，速度提高<color style='color:#f29e38;'>4%</color>，最多叠加<color style='color:#f29e38;'>10</color>层。"
        },
        {
            "id": 3031338,
            "name": "圣显",
            "description": "「战意汹涌」期间我方全体施放战技时消耗等同于自身<color style='color:#f29e38;'>20%</color>生命上限的生命值，并在施放战技后回复自身<color style='color:#f29e38;'>20%</color>生命上限的生命值。"
        },
        {
            "id": 3031329,
            "name": "空头",
            "description": "「战意汹涌」期间，敌方目标受到的击破伤害提高<color style='color:#f29e38;'>30%</color>，我方角色击破敌方目标弱点时，自身行动提前<color style='color:#f29e38;'>12%</color>。"
        }
    ],
